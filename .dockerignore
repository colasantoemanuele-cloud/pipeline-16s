# Il contesto di build contiene solo ciò che serve a costruire l'immagine.
# Tutto il resto è escluso: riduce il trasferimento e impedisce che artefatti
# locali finiscano dentro l'immagine.

.git/
.github/
.venv/
venv/
# A ogni livello, non solo alla radice: i file compilati in locale portano
# nell'immagine i percorsi della macchina su cui sono nati.
**/__pycache__/
**/*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Dati e artefatti: non entrano mai nell'immagine, i percorsi sono parametri
# di configurazione.
*.fastq
*.fastq.gz
*.fq
*.fq.gz
# La versione ridotta del sottoinsieme di prova serve ai test dentro l'immagine.
!tests/fixtures/**/*.fastq.gz
*.rds
*.RDS
# I dati di OSD-734 recuperati in dati/osd734/: l'immagine non li contiene.
dati/osd734/fastq/
dati/osd734/riferimento/
# Il riferimento tassonomico comune scaricato in dati/riferimento/.
dati/riferimento/silva_*
dati/riferimento/SILVA_LICENSE.txt
dati/osd734/lotto/
# Le letture di OSD-276 scaricate in dati/osd276/.
dati/osd276/ena/
dati/osd276/fastq/
results/
output/
outputs/
runs/
work/

.Rhistory
.RData
.Rproj.user/
.env
.DS_Store
