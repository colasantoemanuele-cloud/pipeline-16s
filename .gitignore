# --- Dati grezzi -------------------------------------------------------------
# I dati non vivono mai in questo repository: il dataset completo pesa circa
# 2,5 GB e risiede altrove sul filesystem. I percorsi sono parametri di
# configurazione.
*.fastq
*.fastq.gz
*.fq
*.fq.gz

# --- Artefatti intermedi e output della pipeline -----------------------------
# Le cartelle di output sono parametri di configurazione: se ne viene usata una
# con un nome diverso da questi, va aggiunta qui.
*.rds
*.RDS
# Eccezione: le fixture dei test sono dati di prova versionati, non artefatti
# di esecuzione, e vanno tracciate senza ricorrere a git add -f.
!tests/**/*.rds
!tests/**/*.RDS
# Stessa eccezione per le letture della versione ridotta del sottoinsieme di
# prova: pochi megabyte, sottocampionati da dati pubblici, e la catena di
# integrazione continua non ha altro su cui eseguire le fasi.
!tests/fixtures/**/*.fastq.gz
# I dati di OSD-734 recuperati dagli script di dati/osd734/: letture e file del
# lotto ricostruito. Nel repository restano solo i metadati, gli elenchi con i
# checksum e gli script; i file grandi non devono poter entrare in git per
# errore.
dati/osd734/fastq/
dati/osd734/lotto/
# La collocazione precedente del riferimento tassonomico: resta esclusa, perche'
# una copia di lavoro puo' averla ancora.
dati/osd734/riferimento/
# Il riferimento tassonomico comune ai dataset, scaricato in dati/riferimento/
# accanto allo script, alle fonti e alle impronte, che restano nel repository.
dati/riferimento/*
!dati/riferimento/scarica_riferimento.py
!dati/riferimento/FONTI.tsv
!dati/riferimento/impronte.md5
!dati/riferimento/README.md
*.parziale
*.md5_errato
results/
output/
outputs/
runs/
work/

# --- Python ------------------------------------------------------------------
.venv/
venv/
# Lock di uv, generato quando l'ambiente viene creato con uv: le dipendenze
# sono gia' bloccate con == in pyproject.toml, che resta l'unica fonte.
uv.lock
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- R -----------------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/

# --- Ambiente e sistema ------------------------------------------------------
.env
.DS_Store

# I dati di OSD-276, il secondo dataset, recuperati da dati/osd276/scarica_letture.py:
# i file di ENA e le letture forward che se ne ricavano.
dati/osd276/ena/
dati/osd276/fastq/
