+// Reproducible tie-breaking. When several genera share the best log-probability,
+// get_best_genus picks one uniformly at random. The draws come from a small
+// generator (splitmix64) seeded per call from a base seed, the index of the
+// sequence and the case: forward classification, reverse-complement
+// classification, or bootstrap replicate. The base seed is drawn from R's RNG
+// after the bootstrap uniforms, so set.seed() makes the whole classification
+// reproducible, and each tie has a fixed seed whichever thread computes it.
+#define TIE_CASE_FORWARD 0
+#define TIE_CASE_RC 1
+#define TIE_CASE_BOOT(b) (2 + (b))
+
+static inline uint64_t tie_mix(uint64_t x) {
+  x += 0x9E3779B97F4A7C15ULL;
+  x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
+  return x ^ (x >> 31);
+}
+
+static inline uint64_t tie_seed(uint64_t base, uint64_t seq_index, uint64_t tie_case) {
+  return tie_mix(tie_mix(base ^ tie_mix(seq_index)) ^ tie_case);
+}
   
